# ── Database (production) ──────────────────────────────────────────
# Leave both unset for local dev → uses file:data/jobs.db automatically.
# For Vercel, create a free DB at https://turso.tech (9 GB free):
#   turso db create job-radar
#   turso db show job-radar --url        → TURSO_DATABASE_URL
#   turso db tokens create job-radar     → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Cron protection ─────────────────────────────────────────────────
# Any random string. The same value goes in GitHub Actions secrets.
# Generate one:  openssl rand -hex 24
CRON_SECRET=

# ── Notifications ───────────────────────────────────────────────────
# Nothing to set for the main channel: open the app on your phone and tap
# "Enable alerts" (Web Push). Keys are generated once and stored in the DB.
#
# Optional extra channels:
# Telegram: message @BotFather → /newbot → copy the token, message your bot once,
# then read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy.sh: subscribe to a long random topic in the ntfy app
NTFY_TOPIC=

# ── Misc ────────────────────────────────────────────────────────────
# Public URL of the deployed app (notification links; also the Web Push VAPID subject)
APP_URL=

# Local scheduler interval in minutes (self-hosted/docker only; default 45)
SCAN_INTERVAL_MINUTES=

# How long a single /api/cron invocation may spend scanning, in ms.
# Serverless platforms cap execution time (Vercel Hobby ~60s), so cron scans are
# budgeted and resumable: each run scans as many boards as fit, stores a cursor,
# and the next run continues from there. Default 30000. Raise it on hosts with a
# higher limit (e.g. 250000 on Vercel Pro, or a self-hosted box).
SCAN_BUDGET_MS=

# ── Reach out (optional; each piece switches on when its key is set) ──
# Lock for the outreach panel. REQUIRED in production, since it can send mail as you.
# Enter it once in the panel. Generate one:  openssl rand -hex 16
OUTREACH_KEY=
# Send email from your Gmail: Google Account > Security > 2-Step Verification > App passwords
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# Max emails per day (IST). Keep it at 25-35 on a personal mailbox.
OUTREACH_DAILY_CAP=30
# Lists matching LinkedIn profiles in-app instead of opening Google (serper.dev, free tier)
SERPER_API_KEY=
# Claude drafting needs no key: the panel copies a prompt for claude.ai and you paste the reply back.
# Only when running on your own PC: the path to a logged-in Claude Code CLI adds a one-click button.
# Use forward slashes. Run `claude` and /login once first. It uses your plan's Claude Code allowance. Don't set it on Vercel.
# CLAUDE_CLI=C:/Users/you/.local/bin/claude.exe

# The graduating batch you're hunting for. Roles for any other batch are removed.
TARGET_BATCH=2027
